# Supabase Configuration
# Get these values from your Supabase project settings:
# https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Site Configuration
# For development: http://localhost:3000
# For production: https://nodo360.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth redirect (after login/register)
NEXT_PUBLIC_AUTH_REDIRECT_URL=http://localhost:3000/dashboard

# Discord: invitacion publica al servidor de la comunidad.
# Comprobado contra la API de Discord: esta invitacion no caduca
# (expires_at null). Si falta la variable, el codigo usa este mismo valor
# como respaldo (ver lib/discord/invite.ts), asi que la pagina no se rompe.
NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/ag5aPsNuPY

# Discord Webhooks
# Get webhook URL from Discord channel settings > Integrations > Webhooks
#
# Un webhook apunta siempre a UN canal, asi que hay uno por canal de destino.
# ANNOUNCEMENTS recibe los cursos nuevos. NEWS recibe los articulos del blog;
# si se deja vacia, los articulos caen en ANNOUNCEMENTS.
DISCORD_WEBHOOK_ANNOUNCEMENTS=
DISCORD_WEBHOOK_NEWS=

# Internal API Secret (for internal service-to-service calls)
# Generate a random string: openssl rand -hex 32
INTERNAL_API_SECRET=

# El correo de la cuenta de administracion, PARA LOS SCRIPTS DE DIAGNOSTICO de
# scripts/ (seed-testing-data, test-badges-query, test-enrollments-query). No la usa
# la aplicacion: es una comodidad para no escribir el correo en cada invocacion, y el
# argumento de la linea de ordenes manda sobre ella.
NODO360_ADMIN_EMAIL=

# A quien le llega el aviso de un feedback nuevo, por correo.
#
# Estaba escrita dentro de app/api/feedback/route.ts, y este repositorio es publico.
# Si falta, el feedback SE SIGUE GUARDANDO —y se ve en /admin/feedback—: lo unico que
# no sale es el aviso, y el servidor lo registra diciendo con qué id se quedó sin avisar.
# Hace falta en Production y en Preview.
FEEDBACK_EMAIL_TO=
